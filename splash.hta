<!DOCTYPE html>
<html>
<head>
    <title>Iniciando Portafolio Zen</title>
    <!-- Force IE11 mode for CSS support (animations, CSS variables, flexbox) -->
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <HTA:APPLICATION 
        ID="PortafolioZenSplash"
        APPLICATIONNAME="PortafolioZenSplash"
        BORDER="none"
        CAPTION="no"
        SHOWINTASKBAR="no"
        SINGLEINSTANCE="yes"
        SYSMENU="no"
        WINDOWSTATE="normal"
        INNERBORDER="no"
        SCROLL="no"
        CONTEXTMENU="no"
        SELECTION="no"
    />
    <style>
        body {
            background-color: #0f172a;
            color: #cbd5e1;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            height: 100vh;
            border: 1px solid #334155;
            box-sizing: border-box;
            cursor: wait;
            overflow: hidden;
        }
        .container { text-align: center; }
        h1 { font-size: 26px; font-weight: 300; margin: 0 0 10px 0; color: #f8fafc; letter-spacing: 2px; }
        h1 span { color: #38bdf8; }
        p { font-size: 11px; color: #94a3b8; margin: 0 0 25px 0; letter-spacing: 1px; text-transform: uppercase; }
        .spinner {
            width: 30px; height: 30px;
            border: 2px solid #1e293b;
            border-top: 2px solid #38bdf8;
            border-radius: 50%;
            animation: spin 1s linear infinite;
            margin: 0 auto;
        }
        @keyframes spin { 
            0% { transform: rotate(0deg); } 
            100% { transform: rotate(360deg); } 
        }
    </style>
    <script>
        // Dimensiones de la pantalla splash
        var width = 450;
        var height = 240;
        window.resizeTo(width, height);
        window.moveTo((screen.availWidth - width) / 2, (screen.availHeight - height) / 2);

        // Se cierra automáticamente tras 7 segundos
        window.onload = function() {
            setTimeout(function() {
                window.close();
            }, 7000);
        };
    </script>
</head>
<body>
    <div class="container">
        <h1>PORTAFOLIO <span>ZEN</span></h1>
        <p>Iniciando motores locales de forma oculta</p>
        <div class="spinner"></div>
    </div>
</body>
</html>
